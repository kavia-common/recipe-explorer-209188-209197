---
import MainLayout from "../layouts/MainLayout.astro";
import RecipeCard from "../components/RecipeCard.astro";
import { fetchRecipes } from "../lib/api";
const recipes = await fetchRecipes();
const featured = recipes.slice(0, 9);
---
<MainLayout title="Recipe Explorer — Home">
  <section aria-labelledby="featured-title">
    <div style="display:flex; align-items:center; justify-content:space-between; gap:.75rem; margin:.5rem 0 1rem;">
      <h1 id="featured-title" style="margin:0;">Featured Recipes</h1>
      <a class="secondary-btn" href="/search">Search all</a>
    </div>
    <div class="card-grid">
      {featured.map((r) => (<RecipeCard recipe={r} />))}
    </div>
  </section>
</MainLayout>
